      "mux slotted audio",
      "export final 9:16 mp4"
    ],
    "stitch_tooling": [
      "ffmpeg (overlay, fade, zoompan, xfade=wipeleft/circleopen for torn-paper sims)",
      "optional Skia/Canvas for text plates",
      "optional RemBG / BiRefNet for cutouts"
