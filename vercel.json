{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/guest-page.mjs": {
      "includeFiles": "dist/index.html"
    },
    "api/studio.mjs": {
      "includeFiles": "public/studio/**",
      "maxDuration": 60
    },
    "api/workspace.mjs": {
      "includeFiles": "public/studio/**",
      "maxDuration": 60
    },
    "api/akay-blog-queue.mjs": {
      "maxDuration": 300
    },
    "api/akay-inspirations.mjs": {
      "maxDuration": 300
    },
    "api/assembly.mjs": {
      "includeFiles": "{src/data.ts,cms/music-library.json,scripts/assembly-cloud-worker.mjs}",
      "maxDuration": 800,
      "memory": 1024
    },
    "api/assembly-chat.mjs": {
      "maxDuration": 120,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/akay-blog-queue?action=pulse",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/akay-inspirations?action=pulse",
      "schedule": "31 2 * * *"
    },
    {
      "path": "/api/akay-blog-queue?action=pulse",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/akay-inspirations?action=pulse",
      "schedule": "31 8 * * *"
    },
    {
      "path": "/api/akay-blog-queue?action=pulse",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/akay-inspirations?action=pulse",
      "schedule": "31 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/assets/workspace/:id",
      "destination": "/api/workspace?action=asset&id=:id"
    },
    {
      "source": "/:slug([a-z0-9][a-z0-9-]{2,47})",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|Slackbot|TelegramBot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|Iframely|redditbot|Embedly).*"
        }
      ],
      "destination": "/api/share?slug=:slug"
    },
    {
      "source": "/:slug([a-z0-9][a-z0-9-]{2,47})",
      "destination": "/api/guest-page?slug=:slug"
    },
    {
      "source": "/invitations",
      "destination": "/api/invitation-page"
    },
    {
      "source": "/invitations/:slug",
      "destination": "/api/invitation-page?slug=:slug"
    },
    {
      "source": "/llms.txt",
      "destination": "/llm.txt"
    },
    {
      "source": "/((?!api/|assets/|review/|robots\\.txt$|sitemap\\.xml$|llm\\.txt$|llms\\.txt$|invitations(?:/.*)?$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/catalogue/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llm.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/manage/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assembly",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assembly/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/akay",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/akay/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/((?!$|templates$|blog(?:/.*)?$|about$|contact$|terms$|privacy-policy$|refund-policy$|shipping-policy$|invitations(?:/.*)?$|assets/|robots\\.txt$|sitemap\\.xml$|llm\\.txt$|llms\\.txt$).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
