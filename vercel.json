{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {"api/studio.mjs":{"includeFiles":"public/studio/**","maxDuration":60}},
  "rewrites": [{"source":"/((?!api/|assets/|review/).*)","destination":"/index.html"}],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Frame-Options","value":"DENY"}]},
    {"source":"/manage/(.*)","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"},{"key":"Cache-Control","value":"no-store"}]},
    {"source":"/api/(.*)","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"},{"key":"Cache-Control","value":"no-store"}]},
    {"source":"/((?!$|templates$|blog(?:/.*)?$|about$|contact$|terms$|privacy-policy$|refund-policy$|shipping-policy$|assets/).*)","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"}]}
  ]
}
